<Window x:Class="SihyuPOSPayroll.Views.Dialogs.ReceiptInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Receipt"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#000000"
        Foreground="#F3F4F6"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border Background="#090B17"
            BorderBrush="#1A1D2E"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto" MinHeight="60" MaxHeight="320"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Title bar ── -->
            <Border Grid.Row="0"
                    Background="#0F1220"
                    CornerRadius="10,10,0,0"
                    Padding="20,14"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE9F9;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="#128854"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBlock x:Name="TitleText"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#F3F4F6"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="28" Height="28"
                            Cursor="Hand"
                            Click="CloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Width="28" Height="28">
                                    <TextBlock Text="&#xE711;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="11"
                                               Foreground="#6B7280"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#1A1D2E"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- ── Meta info ── -->
            <StackPanel Grid.Row="1" Margin="20,16,20,0">
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="RECEIPT #"
                                   FontSize="10" FontWeight="SemiBold" Foreground="#6B7280"/>
                        <TextBlock x:Name="ReceiptIdText"
                                   FontSize="22" FontWeight="Bold" Foreground="#128854"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="DATE"
                                   FontSize="10" FontWeight="SemiBold" Foreground="#6B7280"
                                   HorizontalAlignment="Right"/>
                        <TextBlock x:Name="DateText"
                                   FontSize="13" Foreground="#9CA3AF" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
                <Border Background="#0F1220" CornerRadius="6" Padding="12,8" Margin="0,4,0,0">
                    <Grid>
                        <TextBlock Text="Order ID" Foreground="#6B7280" FontSize="13"/>
                        <TextBlock x:Name="OrderIdText"
                                   HorizontalAlignment="Right"
                                   Foreground="#F3F4F6" FontSize="13" FontWeight="SemiBold"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ── Divider ── -->
            <Border Grid.Row="2" Height="1" Background="#1A1D2E" Margin="20,14,20,0"/>

            <!-- ── Items list ── -->
            <ScrollViewer Grid.Row="3"
                          Margin="20,10,20,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- column header -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="88"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="ITEM"
                                   FontSize="10" FontWeight="SemiBold" Foreground="#6B7280"/>
                        <TextBlock Grid.Column="1" Text="QTY"
                                   FontSize="10" FontWeight="SemiBold" Foreground="#6B7280"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="SUBTOTAL"
                                   FontSize="10" FontWeight="SemiBold" Foreground="#6B7280"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <ItemsControl x:Name="ItemsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="Transparent"
                                        BorderBrush="#1A1D2E"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="88"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding ProductName}"
                                                       Foreground="#F3F4F6"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding UnitPriceFormatted}"
                                                       Foreground="#6B7280"
                                                       FontSize="11"
                                                       Margin="0,1,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Quantity}"
                                                   Foreground="#9CA3AF" FontSize="13"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding SubtotalFormatted}"
                                                   Foreground="#F3F4F6" FontSize="13"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ── Total ── -->
            <Border Grid.Row="4"
                    Background="#072219"
                    CornerRadius="8"
                    Margin="20,10,20,0"
                    Padding="14,10">
                <Grid>
                    <TextBlock Text="TOTAL"
                               FontSize="12" FontWeight="SemiBold" Foreground="#477C60"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TotalText"
                               HorizontalAlignment="Right"
                               FontSize="18" FontWeight="Bold" Foreground="#128854"/>
                </Grid>
            </Border>

            <!-- ── Divider ── -->
            <Border Grid.Row="5" Height="1" Background="#1A1D2E" Margin="20,14,20,0"/>

            <!-- ── Action buttons ── -->
            <Grid Grid.Row="6" Margin="20,12,20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Print PDF -->
                <Button Grid.Column="0" x:Name="PdfButton" Height="48" Cursor="Hand" Click="PdfButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="#128854" CornerRadius="7" Height="48">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE749;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" Foreground="#000000"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,5,0"/>
                                        <TextBlock Text="Print PDF"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#000000" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="[ENTER]"
                                               FontSize="10" FontWeight="Bold" Foreground="#005533"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#477C60"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Save JPG -->
                <Button Grid.Column="2" x:Name="JpgButton" Height="48" Cursor="Hand" Click="JpgButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="#0F1220" BorderBrush="#1A1D2E"
                                    BorderThickness="1" CornerRadius="7" Height="48">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xEB9F;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" Foreground="#9CA3AF"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,5,0"/>
                                        <TextBlock Text="Save JPG"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#F3F4F6" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="[F4]"
                                               FontSize="10" Foreground="#6B7280"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#1A1D2E"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Close -->
                <Button Grid.Column="4" Height="48" Cursor="Hand" Click="CloseButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd"
                                    Background="Transparent" BorderBrush="#1A1D2E"
                                    BorderThickness="1" CornerRadius="7" Height="48">
                                <TextBlock Text="Close"
                                           FontSize="13" FontWeight="SemiBold" Foreground="#6B7280"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#0F1220"/>
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#477C60"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
