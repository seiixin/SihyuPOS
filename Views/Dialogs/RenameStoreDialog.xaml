<Window x:Class="SihyuPOSPayroll.Views.Dialogs.RenameStoreDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename Store"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="#090B17"
            BorderBrush="#1A1D2E"
            BorderThickness="1"
            CornerRadius="10">
        <StackPanel>

            <!-- Title bar -->
            <Border Background="#0F1220"
                    CornerRadius="10,10,0,0"
                    Padding="20,14"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE713;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="15"
                                   Foreground="#128854"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <TextBlock Text="Rename Store"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="#F3F4F6"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Width="28" Height="28"
                            Cursor="Hand"
                            Click="Cancel_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="Transparent" CornerRadius="5">
                                    <TextBlock Text="&#xE711;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="11"
                                               Foreground="#6B7280"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#1A1D2E"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Body -->
            <StackPanel Margin="20,18,20,20">
                <TextBlock Text="Store name"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#6B7280"
                           Margin="0,0,0,6"/>

                <Border Background="#0F1220"
                        BorderBrush="#1A1D2E"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="12,0"
                        Height="42">
                    <TextBox x:Name="NameBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#F3F4F6"
                             FontSize="14"
                             VerticalContentAlignment="Center"
                             CaretBrush="#128854"
                             KeyDown="NameBox_KeyDown"/>
                </Border>

                <!-- Action buttons -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Height="40" Cursor="Hand" Click="Cancel_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="#0F1220"
                                        BorderBrush="#1A1D2E"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <TextBlock Text="Cancel"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#9CA3AF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#1A1D2E"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="2" Height="40" Cursor="Hand" Click="Save_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="#128854" CornerRadius="7">
                                    <TextBlock Text="Save"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#000000"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#477C60"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
