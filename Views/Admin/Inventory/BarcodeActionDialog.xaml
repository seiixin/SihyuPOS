<UserControl x:Class="SihyuPOSPayroll.Views.Admin.Inventory.BarcodeActionDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="320" d:DesignWidth="440">

    <!-- Dim overlay -->
    <Grid Background="#99000000">
        <!-- Dialog card — centred -->
        <Border Background="#111827"
                CornerRadius="14"
                BorderBrush="#1F2937"
                BorderThickness="1"
                Padding="28,24"
                Width="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" Color="#000000" ShadowDepth="0" Opacity="0.7"/>
            </Border.Effect>

            <StackPanel>
                <!-- Header row: barcode icon + title -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="&#xE943;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Foreground="#477C60"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBlock Text="Item Found"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#F3F4F6"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Product name -->
                <TextBlock x:Name="ProductNameText"
                           Text=""
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#34D399"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4"/>

                <!-- Category + current stock row -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <TextBlock x:Name="CategoryText"
                               Text=""
                               FontSize="13"
                               Foreground="#6B7280"/>
                    <TextBlock Text=" · "
                               FontSize="13"
                               Foreground="#374151"/>
                    <TextBlock Text="Stock: "
                               FontSize="13"
                               Foreground="#6B7280"/>
                    <TextBlock x:Name="StockText"
                               Text=""
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#9CA3AF"/>
                    <TextBlock Text=" · "
                               FontSize="13"
                               Foreground="#374151"/>
                    <TextBlock Text="Price: ₱"
                               FontSize="13"
                               Foreground="#6B7280"/>
                    <TextBlock x:Name="PriceText"
                               Text=""
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#9CA3AF"/>
                </StackPanel>

                <!-- Divider -->
                <Border BorderBrush="#1F2937" BorderThickness="0,1,0,0" Margin="0,0,0,20"/>

                <!-- Quick-action buttons -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Add Stock (+1) -->
                    <Button x:Name="AddStockButton"
                            Grid.Column="0"
                            Click="AddStock_Click"
                            Height="52"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                                    Background="#0D2818"
                                                    CornerRadius="10"
                                                    BorderBrush="#166534"
                                                    BorderThickness="1">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="MouseOver">
                                                            <Storyboard>
                                                                <ColorAnimation Storyboard.TargetName="Bd"
                                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                    To="#14371F" Duration="0:0:0.1"/>
                                                            </Storyboard>
                                                        </VisualState>
                                                        <VisualState x:Name="Normal"/>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="#4ADE80"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Add Stock"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#4ADE80"/>
                                <TextBlock Text="+1 Quantity"
                                           FontSize="11"
                                           Foreground="#16A34A"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- Edit Product Details -->
                    <Button x:Name="EditButton"
                            Grid.Column="2"
                            Click="EditDetails_Click"
                            Height="52"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd"
                                                    Background="#0F172A"
                                                    CornerRadius="10"
                                                    BorderBrush="#1E3A5F"
                                                    BorderThickness="1">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="MouseOver">
                                                            <Storyboard>
                                                                <ColorAnimation Storyboard.TargetName="Bd"
                                                                    Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                    To="#172035" Duration="0:0:0.1"/>
                                                            </Storyboard>
                                                        </VisualState>
                                                        <VisualState x:Name="Normal"/>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE70F;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="#60A5FA"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Edit Product"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#60A5FA"/>
                                <TextBlock Text="Update Details"
                                           FontSize="11"
                                           Foreground="#1D4ED8"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Cancel link -->
                <Button Content="Cancel"
                        Click="Cancel_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#6B7280"
                        FontSize="13"
                        HorizontalAlignment="Center"
                        Cursor="Hand"
                        Padding="8,4"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
