<UserControl x:Class="SihyuPOSPayroll.Views.Admin.Receipts.Receipts"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:SihyuPOSPayroll.Helpers"
             >

    <UserControl.Resources>
        <helpers:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Border BorderBrush="#D1FAE5" BorderThickness="0,0,0,1" Margin="0,0,0,20" Padding="0,0,0,14">
            <TextBlock Text="Receipts"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#15803D"/>
        </Border>

        <!-- Search + actions -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Background="#F7FCFA"
                    CornerRadius="8"
                    BorderBrush="#EBF7F1"
                    BorderThickness="1"
                    Padding="12,0"
                    Height="40"
                    Margin="0,0,10,0">
                <Grid>
                    <TextBlock Text="&#xE721;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="13"
                               Foreground="#4B6358"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"/>
                    <TextBox x:Name="SearchBox"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#111827"
                             VerticalContentAlignment="Center"
                             Margin="22,0,0,0"/>
                    <TextBlock Text="Search Order ID, Table, or Date"
                               Foreground="#4B6358"
                               Margin="24,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Visibility="{Binding Text.Length, ElementName=SearchBox, Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                </Grid>
            </Border>
            <Button Grid.Column="1" Content="Search" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
            <Button Grid.Column="2" Content="Clear" Command="{Binding ClearSearchCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/>
            <Button Grid.Column="3" Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>

            <!-- Settings gear with dropdown -->
            <Button Grid.Column="4"
                    Width="40" Height="40"
                    Cursor="Hand"
                    ToolTip="Settings"
                    Click="SettingsBtn_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="#F7FCFA"
                                BorderBrush="#A5D6BE"
                                BorderThickness="1"
                                CornerRadius="8"
                                Width="40" Height="40">
                            <TextBlock Text="&#xE713;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Foreground="#4B6358"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DDF2E8"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#15803D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Button.ContextMenu>
                    <ContextMenu Background="Transparent"
                                 BorderBrush="#A5D6BE"
                                 BorderThickness="1">
                        <MenuItem Header="Rename Store"
                                  Command="{Binding PlacementTarget.Tag,
                                            RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  Foreground="#111827"
                                  Background="Transparent">
                            <MenuItem.Icon>
                                <TextBlock Text="&#xE70F;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="12"
                                           Foreground="#15803D"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Button.ContextMenu>
                <!-- Tag carries the command so ContextMenu can bind to it -->
                <Button.Tag>
                    <Binding Path="RenameStoreCommand"/>
                </Button.Tag>
            </Button>
        </Grid>

        <!-- Receipts grid -->
        <Border Grid.Row="2" Background="#F7FCFA" CornerRadius="10" Padding="0">
            <DataGrid ItemsSource="{Binding Receipts}"
                      SelectedItem="{Binding Selected, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      BorderThickness="0"
                      Background="#F7FCFA"
                      GridLinesVisibility="None"
                      ColumnHeaderHeight="44"
                      RowHeight="48">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Receipt ID" Binding="{Binding ReceiptId}" Width="1.2*"/>
                    <DataGridTextColumn Header="Order ID"   Binding="{Binding OrderId}"   Width="1.2*"/>
                    <DataGridTextColumn Header="Table"      Binding="{Binding TableNumber}" Width="1.2*" Visibility="Collapsed"/>
                    <DataGridTextColumn Header="Date"       Binding="{Binding Date}"       Width="2*"/>
                    <DataGridTextColumn Header="Amount"     Binding="{Binding Amount, StringFormat=₱{0:N2}}" Width="1.2*"/>
                    <DataGridTemplateColumn Header="Actions" Width="1.2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Print"
                                            Command="{Binding DataContext.PrintCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding ReceiptId}"
                                            Style="{StaticResource PrimaryButton}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
