<UserControl
    x:Class="SihyuPOSPayroll.Views.Admin.Employees.AddEditEmployee"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    d:DesignWidth="520" d:DesignHeight="700">

    <Border Background="#090B17"
            BorderBrush="#1A1D2E"
            BorderThickness="1"
            CornerRadius="14"
            Width="500"
            MaxHeight="700">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" Color="#000000" ShadowDepth="0" Opacity="0.70"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- header -->
                <RowDefinition Height="*"/>       <!-- scrollable body -->
                <RowDefinition Height="Auto"/>   <!-- footer buttons -->
            </Grid.RowDefinitions>

            <!-- ── Modal header ───────────────────────────────────────────── -->
            <Border Grid.Row="0" Padding="28,22,22,18"
                    BorderBrush="#1A1D2E" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="TitleText"
                                   Text="Add New Employee"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="#F3F4F6"/>
                        <TextBlock x:Name="SubtitleText"
                                   Text="Fill in the employee details below."
                                   FontSize="12" Foreground="#6B7280"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <!-- Close × -->
                    <Button Content="&#xE711;"
                            FontFamily="Segoe MDL2 Assets" FontSize="13"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Width="32" Height="32" Padding="0"
                            Foreground="#6B7280" Cursor="Hand"
                            Click="Cancel_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#1A1D2E"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- ── Scrollable body ────────────────────────────────────────── -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="28,20,28,4">
                <StackPanel>

                    <!-- Auto-fill tip -->
                    <Border Background="#0A1F14" CornerRadius="8"
                            BorderBrush="#166534" BorderThickness="1"
                            Padding="12,10" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="13" Foreground="#4ADE80"
                                       VerticalAlignment="Top" Margin="0,1,10,0"/>
                            <TextBlock TextWrapping="Wrap" FontSize="12"
                                       Foreground="#9CA3AF" MaxWidth="380">
                                Selecting a <Run Foreground="#4ADE80">Position</Run> auto-fills Salary Per Day from
                                the Positions &amp; Salaries setup. Enable <Run Foreground="#4ADE80">Manual Override</Run>
                                to enter a custom salary.
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Section: Personal Info -->
                    <TextBlock Text="PERSONAL INFORMATION"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,12"/>

                    <!-- Full Name -->
                    <TextBlock Text="Full Name *" FontSize="12" FontWeight="SemiBold"
                               Foreground="#9CA3AF" Margin="0,0,0,6"/>
                    <Border Background="#161929" CornerRadius="8"
                            BorderBrush="#1A1D2E" BorderThickness="1"
                            Margin="0,0,0,14">
                        <Grid>
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="13" Foreground="#6B7280"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <TextBox x:Name="FullNameTextBox"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="#FFFFFF" FontSize="13"
                                     Padding="34,10,10,10"
                                     CaretBrush="#477C60" SelectionBrush="#128854"/>
                        </Grid>
                    </Border>

                    <!-- Age + Sex row -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Age" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#9CA3AF" Margin="0,0,0,6"/>
                            <Border Background="#161929" CornerRadius="8"
                                    BorderBrush="#1A1D2E" BorderThickness="1">
                                <TextBox x:Name="AgeTextBox"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="#FFFFFF" FontSize="13"
                                         Padding="12,10,10,10"
                                         CaretBrush="#477C60" SelectionBrush="#128854"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Sex" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#9CA3AF" Margin="0,0,0,6"/>
                            <ComboBox x:Name="SexComboBox" Height="40"
                                      Background="#0D0F1A" Foreground="#F3F4F6"
                                      BorderBrush="#1A1D2E" FontSize="13"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Male"/>
                                <ComboBoxItem Content="Female"/>
                                <ComboBoxItem Content="Other"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Birthday + Date Hired row -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Birthday" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#9CA3AF" Margin="0,0,0,6"/>
                            <DatePicker x:Name="BirthdayDatePicker" Height="40"
                                        SelectedDateFormat="Short"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Date Hired" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#9CA3AF" Margin="0,0,0,6"/>
                            <DatePicker x:Name="DateHiredDatePicker" Height="40"
                                        SelectedDateFormat="Short"/>
                        </StackPanel>
                    </Grid>

                    <!-- Address -->
                    <TextBlock Text="Address" FontSize="12" FontWeight="SemiBold"
                               Foreground="#9CA3AF" Margin="0,0,0,6"/>
                    <Border Background="#161929" CornerRadius="8"
                            BorderBrush="#1A1D2E" BorderThickness="1"
                            Margin="0,0,0,14">
                        <TextBox x:Name="AddressTextBox"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="#FFFFFF" FontSize="13"
                                 Padding="12,10,10,10"
                                 CaretBrush="#477C60" SelectionBrush="#128854"/>
                    </Border>

                    <!-- Contact + Emergency Contact -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Contact Number" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#9CA3AF" Margin="0,0,0,6"/>
                            <Border Background="#161929" CornerRadius="8"
                                    BorderBrush="#1A1D2E" BorderThickness="1">
                                <TextBox x:Name="ContactNumberTextBox"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="#FFFFFF" FontSize="13"
                                         Padding="12,10,10,10"
                                         CaretBrush="#477C60" SelectionBrush="#128854"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Emergency Contact" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#9CA3AF" Margin="0,0,0,6"/>
                            <Border Background="#161929" CornerRadius="8"
                                    BorderBrush="#1A1D2E" BorderThickness="1">
                                <TextBox x:Name="EmergencyContactTextBox"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="#FFFFFF" FontSize="13"
                                         Padding="12,10,10,10"
                                         CaretBrush="#477C60" SelectionBrush="#128854"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Divider -->
                    <Border Height="1" Background="#1A1D2E" Margin="0,4,0,20"/>

                    <!-- Section: Job Details -->
                    <TextBlock Text="JOB DETAILS"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,12"/>

                    <!-- Position -->
                    <TextBlock Text="Position *" FontSize="12" FontWeight="SemiBold"
                               Foreground="#9CA3AF" Margin="0,0,0,6"/>
                    <ComboBox x:Name="PositionComboBox"
                              Height="40" Margin="0,0,0,4"
                              IsEditable="True" StaysOpenOnEdit="True"
                              IsTextSearchEnabled="True"
                              Background="#0D0F1A" Foreground="#F3F4F6"
                              BorderBrush="#1A1D2E" FontSize="13"
                              SelectionChanged="PositionComboBox_SelectionChanged"/>
                    <TextBlock Text="Start typing to filter positions…"
                               FontSize="11" Foreground="#374151"
                               Margin="0,0,0,14"/>

                    <!-- Salary + Manual Override -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Salary Per Day" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#9CA3AF" Margin="0,0,0,6"/>
                            <Border Background="#161929" CornerRadius="8"
                                    BorderBrush="#1A1D2E" BorderThickness="1">
                                <Grid>
                                    <TextBlock Text="₱" Foreground="#6B7280" FontSize="13"
                                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <TextBox x:Name="SalaryPerDayTextBox"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="#FFFFFF" FontSize="13"
                                             Padding="26,10,10,10"
                                             CaretBrush="#477C60" SelectionBrush="#128854"
                                             IsReadOnly="True"
                                             ToolTip="Auto-filled from position. Enable Manual Override to edit."/>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,8">
                            <CheckBox x:Name="ManualOverrideCheckBox"
                                      Content="Manual Override"
                                      Foreground="#9CA3AF" FontSize="12"
                                      Checked="ManualOverrideCheckBox_Checked"
                                      Unchecked="ManualOverrideCheckBox_Unchecked"/>
                        </StackPanel>
                    </Grid>

                    <!-- Work Schedule + Shift -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Work Schedule" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#9CA3AF" Margin="0,0,0,6"/>
                            <ComboBox x:Name="WorkScheduleComboBox" Height="40"
                                      Background="#0D0F1A" Foreground="#F3F4F6"
                                      BorderBrush="#1A1D2E" FontSize="13"
                                      DisplayMemberPath="Label" SelectedValuePath="Id"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Shift" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#9CA3AF" Margin="0,0,0,6"/>
                            <ComboBox x:Name="ShiftComboBox" Height="40"
                                      Background="#0D0F1A" Foreground="#F3F4F6"
                                      BorderBrush="#1A1D2E" FontSize="13"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Morning"/>
                                <ComboBoxItem Content="Afternoon"/>
                                <ComboBoxItem Content="Night"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Divider -->
                    <Border Height="1" Background="#1A1D2E" Margin="0,4,0,20"/>

                    <!-- Section: Government IDs -->
                    <TextBlock Text="GOVERNMENT IDs"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,12"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="SSS Number" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#9CA3AF" Margin="0,0,0,6"/>
                            <Border Background="#161929" CornerRadius="8"
                                    BorderBrush="#1A1D2E" BorderThickness="1">
                                <TextBox x:Name="SssNumberTextBox"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="#FFFFFF" FontSize="12"
                                         Padding="10,10"
                                         CaretBrush="#477C60" SelectionBrush="#128854"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="PhilHealth" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#9CA3AF" Margin="0,0,0,6"/>
                            <Border Background="#161929" CornerRadius="8"
                                    BorderBrush="#1A1D2E" BorderThickness="1">
                                <TextBox x:Name="PhilhealthNumberTextBox"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="#FFFFFF" FontSize="12"
                                         Padding="10,10"
                                         CaretBrush="#477C60" SelectionBrush="#128854"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Pag-IBIG" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#9CA3AF" Margin="0,0,0,6"/>
                            <Border Background="#161929" CornerRadius="8"
                                    BorderBrush="#1A1D2E" BorderThickness="1">
                                <TextBox x:Name="PagibigNumberTextBox"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="#FFFFFF" FontSize="12"
                                         Padding="10,10"
                                         CaretBrush="#477C60" SelectionBrush="#128854"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Divider -->
                    <Border Height="1" Background="#1A1D2E" Margin="0,4,0,20"/>

                    <!-- Section: Photo + Account Status -->
                    <TextBlock Text="PHOTO &amp; ACCOUNT"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="#374151" Margin="0,0,0,12"/>

                    <!-- Profile photo -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Preview circle -->
                        <Border Grid.Column="0" Width="72" Height="72" CornerRadius="36"
                                Background="#0D2818" ClipToBounds="True"
                                BorderBrush="#1A1D2E" BorderThickness="1">
                            <Grid>
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="30" Foreground="#1F2937"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                <Image x:Name="ImagePreview"
                                       Stretch="UniformToFill"
                                       Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Button x:Name="UploadImageButton"
                                    Content="Choose Photo"
                                    Style="{StaticResource SecondaryButton}"
                                    Height="36" Padding="16,0"
                                    HorizontalAlignment="Left"
                                    Click="UploadImage_Click"/>
                            <TextBlock x:Name="SelectedImageLabel"
                                       Text="No file selected"
                                       FontSize="11" Foreground="#4B5563"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Account status -->
                    <TextBlock Text="Account Status" FontSize="12" FontWeight="SemiBold"
                               Foreground="#9CA3AF" Margin="0,0,0,6"/>
                    <TextBlock Text="Controls whether this employee can log in to the system."
                               FontSize="11" Foreground="#4B5563" Margin="0,0,0,8"/>
                    <ComboBox x:Name="StatusComboBox"
                              Height="40" Margin="0,0,0,20"
                              Background="#0D0F1A" Foreground="#F3F4F6"
                              BorderBrush="#1A1D2E" FontSize="13"
                              SelectedIndex="0"
                              SelectedValuePath="Tag">
                        <ComboBoxItem Content="Active — can log in"    Tag="1"/>
                        <ComboBoxItem Content="Inactive — cannot log in" Tag="0"/>
                    </ComboBox>

                </StackPanel>
            </ScrollViewer>

            <!-- ── Footer buttons ─────────────────────────────────────────── -->
            <Border Grid.Row="2"
                    BorderBrush="#1A1D2E" BorderThickness="0,1,0,0"
                    Padding="28,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0"
                            Content="Cancel"
                            Style="{StaticResource SecondaryButton}"
                            Height="40"
                            Click="Cancel_Click"/>
                    <Button Grid.Column="2"
                            x:Name="SaveButton"
                            Content="Save Employee"
                            Style="{StaticResource PrimaryButton}"
                            Height="40"
                            Click="Save_Click"/>
                </Grid>
            </Border>

        </Grid>
    </Border>
</UserControl>
