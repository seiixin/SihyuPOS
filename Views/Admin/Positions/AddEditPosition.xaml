<UserControl
    x:Class="SihyuPOSPayroll.Views.Admin.Positions.AddEditPosition"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    d:DesignWidth="460" d:DesignHeight="320">

    <Border Background="#090B17"
            BorderBrush="#1A1D2E"
            BorderThickness="1"
            CornerRadius="14"
            Width="440"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" Color="#000000" ShadowDepth="0" Opacity="0.70"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Padding="28,22,22,18"
                    BorderBrush="#1A1D2E" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="TitleText" Text="Add Position"
                                   FontSize="18" FontWeight="Bold" Foreground="#F3F4F6"/>
                        <TextBlock x:Name="SubtitleText"
                                   Text="Define a job position and its daily rate."
                                   FontSize="12" Foreground="#6B7280" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Width="32" Height="32" Padding="0" Foreground="#6B7280"
                            Cursor="Hand" Click="Cancel_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#1A1D2E"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="28,20,28,8">

                <!-- Position Name -->
                <TextBlock Text="Position Name *" FontSize="12" FontWeight="SemiBold"
                           Foreground="#9CA3AF" Margin="0,0,0,6"/>
                <Border Background="#0D0F1A" CornerRadius="8"
                        BorderBrush="#1A1D2E" BorderThickness="1"
                        Margin="0,0,0,16">
                    <Grid>
                        <TextBlock Text="&#xE821;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="13" Foreground="#374151"
                                   VerticalAlignment="Center" Margin="12,0,0,0"/>
                        <TextBox x:Name="PositionTextBox"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="#F3F4F6" FontSize="13"
                                 Padding="34,10,10,10" CaretBrush="#477C60"/>
                    </Grid>
                </Border>

                <!-- Daily Rate + Active -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Daily Rate (₱)" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#9CA3AF" Margin="0,0,0,6"/>
                        <Border Background="#0D0F1A" CornerRadius="8"
                                BorderBrush="#1A1D2E" BorderThickness="1">
                            <Grid>
                                <TextBlock Text="₱" Foreground="#374151" FontSize="13"
                                           VerticalAlignment="Center" Margin="12,0,0,0"/>
                                <TextBox x:Name="DailyRateTextBox"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="#F3F4F6" FontSize="13"
                                         Padding="26,10,10,10" CaretBrush="#477C60"
                                         PreviewTextInput="NumericOnly_PreviewTextInput"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,8">
                        <CheckBox x:Name="IsActiveCheckBox"
                                  Content="Active"
                                  IsChecked="True"
                                  Foreground="#9CA3AF" FontSize="12"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Active positions appear in the employee Position dropdown."
                           FontSize="11" Foreground="#4B5563"/>

            </StackPanel>

            <!-- Footer buttons -->
            <Border Grid.Row="2" BorderBrush="#1A1D2E" BorderThickness="0,1,0,0" Padding="28,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Cancel"
                            Style="{StaticResource SecondaryButton}"
                            Height="40" Click="Cancel_Click"/>
                    <Button Grid.Column="2" x:Name="SaveButton"
                            Content="Save Position"
                            Style="{StaticResource PrimaryButton}"
                            Height="40" Click="Save_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
