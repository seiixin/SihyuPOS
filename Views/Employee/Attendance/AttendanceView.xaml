<UserControl x:Class="SihyuPOSPayroll.Views.Employee.Attendance.AttendanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:models="clr-namespace:SihyuPOSPayroll.Models"
             >

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <ObjectDataProvider x:Key="LeaveTypeValues" MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:LeaveType"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ObjectDataProvider x:Key="LeaveStatusValues" MethodName="GetValues"
                            ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:LeaveStatus"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!-- Tab style matching the rest of the app -->
        <Style x:Key="DarkTabItem" TargetType="TabItem">
            <Setter Property="Foreground"      Value="#4B6358"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="18,10"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="Transparent"
                                BorderBrush="Transparent" BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock x:Name="TabText" Text="{TemplateBinding Header}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#15803D"/>
                                <Setter TargetName="TabText"   Property="Foreground"  Value="#111827"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabText" Property="Foreground" Value="#111827"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark input style -->
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background"      Value="#F7FCFA"/>
            <Setter Property="Foreground"      Value="#111827"/>
            <Setter Property="BorderBrush"     Value="#A5D6BE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="CaretBrush"      Value="#15803D"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"     Value="#15803D"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTextBoxMulti" TargetType="TextBox" BasedOn="{StaticResource DarkTextBox}">
            <Setter Property="Height"          Value="Auto"/>
            <Setter Property="MinHeight"       Value="72"/>
            <Setter Property="AcceptsReturn"   Value="True"/>
            <Setter Property="TextWrapping"    Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Padding"         Value="10,8"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>

        <Style x:Key="DarkDatePickerTextBox" TargetType="DatePickerTextBox">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="Foreground"      Value="#111827"/>
            <Setter Property="CaretBrush"      Value="#15803D"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePickerTextBox">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent"
                                          BorderThickness="0" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                            <ContentControl x:Name="PART_Watermark"
                                            Content="{TemplateBinding Tag}"
                                            Foreground="#4B6358" Focusable="False"
                                            IsHitTestVisible="False"
                                            Margin="{TemplateBinding Padding}"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="PART_Watermark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Text" Value="{x:Null}">
                                <Setter TargetName="PART_Watermark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkDatePicker" TargetType="DatePicker">
            <Setter Property="Background"      Value="#F7FCFA"/>
            <Setter Property="Foreground"      Value="#111827"/>
            <Setter Property="BorderBrush"     Value="#A5D6BE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="32"/>
                                </Grid.ColumnDefinitions>
                                <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
                                                   Style="{StaticResource DarkDatePickerTextBox}"
                                                   Tag="Select date"
                                                   Foreground="{TemplateBinding Foreground}"/>
                                <Button x:Name="PART_Button" Grid.Column="1"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" Focusable="False"
                                        VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="13" Foreground="#15803D"/>
                                </Button>
                                <Popup x:Name="PART_Popup" Grid.Column="0"
                                       AllowsTransparency="True" Placement="Bottom"
                                       PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                       StaysOpen="False"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"     Value="#15803D"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background"      Value="#F7FCFA"/>
            <Setter Property="Foreground"      Value="#111827"/>
            <Setter Property="BorderBrush"     Value="#A5D6BE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height"          Value="36"/>
            <Setter Property="Padding"         Value="10,0"/>
            <Setter Property="FontSize"        Value="13"/>
        </Style>

        <!-- Label style -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="#4B6358"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="Margin"      Value="0,0,0,4"/>
        </Style>

        <!-- Card panel -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="#F7FCFA"/>
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="BorderBrush"     Value="#A5D6BE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="20,16"/>
        </Style>

        <!-- Status badge -->
        <Style x:Key="BadgePresent" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="#4B6358"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
        </Style>
        <Style x:Key="BadgeMissing" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="#F87171"/>
        </Style>
        <Style x:Key="BadgeDayOff" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="#4B6358"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Page header ── -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border BorderBrush="#D1FAE5" BorderThickness="0,0,0,1" Padding="0,0,0,14">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="My Attendance"
                               FontSize="26" FontWeight="Bold" Foreground="#15803D"/>
                    <TextBlock Text="{Binding EmployeeDisplay}"
                               FontSize="13" Foreground="#4B6358" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Worked days pill -->
            <Border Grid.Column="1" Background="#D1FAE5" CornerRadius="8"
                    BorderBrush="#1A4D35" BorderThickness="1"
                    Padding="14,8" VerticalAlignment="Bottom" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7EF;" FontFamily="Segoe MDL2 Assets"
                               FontSize="14" Foreground="#4B6358" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Foreground="#4B6358" FontSize="12" VerticalAlignment="Center">
                        <Run Text="Worked days: "/>
                    </TextBlock>
                    <TextBlock Text="{Binding LastMessage}" Foreground="#4B6358"
                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                               MaxWidth="420" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── Tab control ── -->
        <TabControl Grid.Row="1"
                    Background="Transparent"
                    BorderBrush="#D1FAE5"
                    BorderThickness="0,1,0,0"
                    Padding="0,8,0,0">

            <!-- ══════════════════════════ ATTENDANCE TAB ══════════════════════════ -->
            <TabItem Header="Attendance" Style="{StaticResource DarkTabItem}">
                <Grid Margin="0,16,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ── Clock In/Out card ── -->
                    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: manual inputs -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Clock In / Clock Out"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="#111827" Margin="0,0,0,14"/>

                                <!-- Manual mode toggle -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <CheckBox IsChecked="{Binding IsManualMode, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="Enter date &amp; time manually"
                                               Foreground="#4B6358" FontSize="12"
                                               VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Manual date + time row -->
                                <Grid IsEnabled="{Binding IsManualMode}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="140"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Date" Style="{StaticResource FieldLabel}"/>
                                        <DatePicker SelectedDate="{Binding ManualDate, Mode=TwoWay}"
                                                    Style="{StaticResource DarkDatePicker}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Time (HH:mm)" Style="{StaticResource FieldLabel}"/>
                                        <TextBox Text="{Binding ManualTimeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 MaxLength="8"
                                                 Style="{StaticResource DarkTextBox}"
                                                 ToolTip="Format: HH:mm or HH:mm:ss"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- Divider -->
                            <Border Grid.Column="1" Background="#A5D6BE" Width="1" Margin="20,0"/>

                            <!-- Right: action buttons -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="160">
                                <Button Command="{Binding ClockInCommand}"
                                        Height="44" Margin="0,0,0,10"
                                        Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background"  Value="#15803D"/>
                                            <Setter Property="Foreground"  Value="White"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="FontSize"    Value="14"/>
                                            <Setter Property="FontWeight"  Value="SemiBold"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                                CornerRadius="8">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#0EA16A"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter TargetName="Bd" Property="Background" Value="#1A2E25"/>
                                                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7EF;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Clock In" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Command="{Binding ClockOutCommand}"
                                        Height="44" Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background"  Value="#A5D6BE"/>
                                            <Setter Property="Foreground"  Value="#111827"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="BorderBrush" Value="#2D3148"/>
                                            <Setter Property="FontSize"    Value="14"/>
                                            <Setter Property="FontWeight"  Value="SemiBold"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="8">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#252840"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7EF;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Clock Out" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ── Filter bar ── -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="From" Foreground="#4B6358"
                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker Grid.Column="1" SelectedDate="{Binding FilterFromDate, Mode=TwoWay}"
                                    Style="{StaticResource DarkDatePicker}"/>

                        <TextBlock Grid.Column="3" Text="To" Foreground="#4B6358"
                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker Grid.Column="4" SelectedDate="{Binding FilterToDate, Mode=TwoWay}"
                                    Style="{StaticResource DarkDatePicker}"/>

                        <Button Grid.Column="6" Content="Apply" Height="36" Width="80"
                                Command="{Binding ApplyFilterCommand}"
                                Style="{StaticResource PrimaryButton}"/>
                        <Button Grid.Column="8" Content="Reset" Height="36" Width="80"
                                Command="{Binding ResetFilterCommand}"
                                Style="{StaticResource SecondaryButton}"/>
                        <Button Grid.Column="10" Content="Refresh" Height="36" Width="90"
                                Command="{Binding RefreshListCommand}"
                                Style="{StaticResource SecondaryButton}"/>
                    </Grid>

                    <!-- ── Progress bar ── -->
                    <ProgressBar Grid.Row="1" Height="2" IsIndeterminate="True" VerticalAlignment="Bottom"
                                 Foreground="#15803D" Background="Transparent"
                                 Visibility="{Binding IsBusyAttendance, Converter={StaticResource BoolToVis}}"
                                 Margin="0,0,0,0"/>

                    <!-- ── Attendance table ── -->
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                        <DataGrid ItemsSource="{Binding Attendances}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  EnableRowVirtualization="True"
                                  RowHeaderWidth="0"
                                  HeadersVisibility="Column"
                                  BorderThickness="0"
                                  Background="#F7FCFA"
                                  GridLinesVisibility="None"
                                  RowHeight="46"
                                  ColumnHeaderHeight="42">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background"   Value="#EBF7F1"/>
                                    <Setter Property="Foreground"   Value="#4B6358"/>
                                    <Setter Property="FontSize"     Value="11"/>
                                    <Setter Property="FontWeight"   Value="SemiBold"/>
                                    <Setter Property="Padding"      Value="16,0"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush"  Value="#A5D6BE"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#EBF7F1"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#D1FAE5"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#D1FAE5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Foreground"      Value="#374151"/>
                                    <Setter Property="FontSize"        Value="13"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding"         Value="16,0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Padding="{TemplateBinding Padding}"
                                                        Background="{TemplateBinding Background}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DATE"
                                                    Binding="{Binding Date, StringFormat={}{0:MMM dd, yyyy}}"
                                                    Width="1.2*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#374151"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="TIME IN"
                                                    Binding="{Binding TimeIn, TargetNullValue='—'}"
                                                    Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#4B6358"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="TIME OUT"
                                                    Binding="{Binding TimeOut, TargetNullValue='—'}"
                                                    Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#60A5FA"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="STATUS" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#A5D6BE"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Present">
                                                                <Setter Property="Background" Value="#D1FAE5"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Clocked In">
                                                                <Setter Property="Background" Value="#1A2D10"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status, TargetNullValue='—'}" FontSize="12" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#4B6358"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Present">
                                                                    <Setter Property="Foreground" Value="#4B6358"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Clocked In">
                                                                    <Setter Property="Foreground" Value="#4B6358"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ══════════════════════════ LEAVE REQUESTS TAB ══════════════════════════ -->
            <TabItem Header="Leave Requests" Style="{StaticResource DarkTabItem}">
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ── LEFT: Request Form ── -->
                    <Border Grid.Column="0" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Leave Request Form"
                                       FontSize="15" FontWeight="SemiBold"
                                       Foreground="#111827" Margin="0,0,0,16"/>

                            <!-- Type -->
                            <TextBlock Text="LEAVE TYPE" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding Source={StaticResource LeaveTypeValues}}"
                                      SelectedItem="{Binding LeaveType, Mode=TwoWay}"
                                      Style="{StaticResource DarkComboBox}"
                                      Margin="0,0,0,12"/>

                            <!-- Reason -->
                            <TextBlock Text="REASON" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding LeaveReason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource DarkTextBoxMulti}"
                                     Margin="0,0,0,12"/>

                            <!-- Date range -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="FROM" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker SelectedDate="{Binding LeaveDateFrom, Mode=TwoWay}"
                                                Style="{StaticResource DarkDatePicker}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="TO" Style="{StaticResource FieldLabel}"/>
                                    <DatePicker SelectedDate="{Binding LeaveDateTo, Mode=TwoWay}"
                                                Style="{StaticResource DarkDatePicker}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Half day + duration -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <CheckBox IsChecked="{Binding LeaveHalfDay, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Half day" Foreground="#4B6358"
                                               FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#D1FAE5" CornerRadius="6"
                                        Padding="8,4" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding LeaveDurationDays}"
                                               Foreground="#4B6358" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </Grid>

                            <!-- Buttons -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="New Form" Height="36"
                                        Command="{Binding NewLeaveFormCommand}"
                                        Style="{StaticResource SecondaryButton}"/>
                                <Button Grid.Column="2" Content="Submit" Height="36"
                                        Command="{Binding SubmitLeaveRequestCommand}"
                                        Style="{StaticResource PrimaryButton}"/>
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="Update" Height="36"
                                        Command="{Binding UpdateLeaveRequestCommand}"
                                        Style="{StaticResource SecondaryButton}"/>
                                <Button Grid.Column="2" Content="Cancel Request" Height="36"
                                        Command="{Binding CancelLeaveRequestCommand}"
                                        Style="{StaticResource DangerButton}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ── RIGHT: Filter + List ── -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Filter bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="From" Foreground="#4B6358"
                                       FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <DatePicker Grid.Column="1" SelectedDate="{Binding LeaveFilterFrom, Mode=TwoWay}"
                                        Style="{StaticResource DarkDatePicker}"/>

                            <TextBlock Grid.Column="3" Text="To" Foreground="#4B6358"
                                       FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <DatePicker Grid.Column="4" SelectedDate="{Binding LeaveFilterTo, Mode=TwoWay}"
                                        Style="{StaticResource DarkDatePicker}"/>

                            <ComboBox Grid.Column="6"
                                      ItemsSource="{Binding Source={StaticResource LeaveStatusValues}}"
                                      SelectedItem="{Binding LeaveFilterStatus, Mode=TwoWay}"
                                      Style="{StaticResource DarkComboBox}"/>

                            <Button Grid.Column="8" Content="Apply" Height="36" Width="76"
                                    Command="{Binding ApplyLeaveFilterCommand}"
                                    Style="{StaticResource PrimaryButton}"/>
                            <Button Grid.Column="10" Content="Reset" Height="36" Width="76"
                                    Command="{Binding ResetLeaveFilterCommand}"
                                    Style="{StaticResource SecondaryButton}"/>
                            <Button Grid.Column="12" Content="Refresh" Height="36" Width="84"
                                    Command="{Binding LoadLeaveListCommand}"
                                    Style="{StaticResource SecondaryButton}"/>
                        </Grid>

                        <!-- Progress -->
                        <ProgressBar Grid.Row="0" Height="2" IsIndeterminate="True" VerticalAlignment="Bottom"
                                     Foreground="#15803D" Background="Transparent"
                                     Visibility="{Binding IsBusyLeave, Converter={StaticResource BoolToVis}}"/>

                        <!-- Leave table -->
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DataGrid Grid.Row="0"
                                          ItemsSource="{Binding LeaveRequests}"
                                          SelectedItem="{Binding SelectedLeave, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          EnableRowVirtualization="True"
                                          RowHeaderWidth="0"
                                          HeadersVisibility="Column"
                                          BorderThickness="0"
                                          Background="#F7FCFA"
                                          GridLinesVisibility="None"
                                          RowHeight="46"
                                          ColumnHeaderHeight="42">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background"   Value="#EBF7F1"/>
                                            <Setter Property="Foreground"   Value="#4B6358"/>
                                            <Setter Property="FontSize"     Value="11"/>
                                            <Setter Property="FontWeight"   Value="SemiBold"/>
                                            <Setter Property="Padding"      Value="16,0"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="BorderBrush"  Value="#A5D6BE"/>
                                        </Style>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="Background"      Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Setter Property="BorderBrush"     Value="#EBF7F1"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#D1FAE5"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#D1FAE5"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.CellStyle>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="Foreground"      Value="#374151"/>
                                            <Setter Property="FontSize"        Value="13"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding"         Value="16,0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="DataGridCell">
                                                        <Border Padding="{TemplateBinding Padding}"
                                                                Background="{TemplateBinding Background}">
                                                            <ContentPresenter VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </DataGrid.CellStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="FROM"
                                                            Binding="{Binding DateFrom, StringFormat={}{0:MMM dd, yyyy}}"
                                                            Width="*"/>
                                        <DataGridTextColumn Header="TO"
                                                            Binding="{Binding DateTo, StringFormat={}{0:MMM dd, yyyy}}"
                                                            Width="*"/>
                                        <DataGridTextColumn Header="TYPE"
                                                            Binding="{Binding LeaveType}"
                                                            Width="*"/>
                                        <DataGridTemplateColumn Header="STATUS" Width="*">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="4" Padding="8,3"
                                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#A5D6BE"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Approved">
                                                                        <Setter Property="Background" Value="#D1FAE5"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                                        <Setter Property="Background" Value="#2D1515"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="#4B6358"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Approved">
                                                                            <Setter Property="Foreground" Value="#4B6358"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                                            <Setter Property="Foreground" Value="#F87171"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                                            <Setter Property="Foreground" Value="#D97706"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="REASON"
                                                            Binding="{Binding Reason}"
                                                            Width="2*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Load into form button -->
                                <Border Grid.Row="1" BorderBrush="#A5D6BE" BorderThickness="0,1,0,0"
                                        Padding="16,10">
                                    <Button Content="Load Selected into Form"
                                            Command="{Binding EditSelectedLeaveCommand}"
                                            HorizontalAlignment="Right"
                                            Height="34" Padding="16,0"
                                            Style="{StaticResource SecondaryButton}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
