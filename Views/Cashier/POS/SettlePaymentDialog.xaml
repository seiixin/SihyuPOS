<UserControl x:Class="SihyuPOSPayroll.Views.Cashier.POS.SettlePaymentDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             MinWidth="760">

    <UserControl.Resources>

        <!-- Numpad digit key -->
        <Style x:Key="NKey" TargetType="Button">
            <Setter Property="Background"       Value="#0F1220"/>
            <Setter Property="Foreground"       Value="#F3F4F6"/>
            <Setter Property="BorderBrush"      Value="#1A1D2E"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="FontSize"         Value="18"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="Height"           Value="48"/>
            <Setter Property="Margin"           Value="3"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1A1D2E"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#272A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick-amount shortcut key -->
        <Style x:Key="QKey" TargetType="Button" BasedOn="{StaticResource NKey}">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Height"     Value="36"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
        </Style>

    </UserControl.Resources>

    <Border Background="#090B17"
            BorderBrush="#1A1D2E"
            BorderThickness="1"
            CornerRadius="10"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">
        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                <Border Width="38" Height="38" CornerRadius="19"
                        Background="#0A2118" Margin="0,0,12,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#xE7BF;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="17" Foreground="#10B981"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Settle Payment"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#F3F4F6"/>
                    <TextBlock x:Name="SubtitleText"
                               Text="Order #0"
                               FontSize="12" Foreground="#6B7280"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- DIVIDER -->
            <Border Grid.Row="1" Background="#1A1D2E" Margin="0,0,0,20"/>

            <!-- BODY: two columns -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="248"/>
                </Grid.ColumnDefinitions>

                <!-- ===================================================
                     LEFT: Payment fields
                     =================================================== -->
                <StackPanel Grid.Column="0">

                    <!-- Payment Method -->
                    <TextBlock Text="Payment Method"
                               Foreground="#9CA3AF" FontWeight="SemiBold" FontSize="12"
                               Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <RadioButton x:Name="RbCash"    Content="Cash"           GroupName="PM" IsChecked="True"
                                     Foreground="#F3F4F6" FontSize="13" Margin="0,0,18,0" Checked="PayMethod_Checked"/>
                        <RadioButton x:Name="RbGcash"   Content="GCash"          GroupName="PM"
                                     Foreground="#F3F4F6" FontSize="13" Margin="0,0,18,0" Checked="PayMethod_Checked"/>
                        <RadioButton x:Name="RbOnline"  Content="Online Banking" GroupName="PM"
                                     Foreground="#F3F4F6" FontSize="13"            Checked="PayMethod_Checked"/>
                    </StackPanel>

                    <!-- Total -->
                    <TextBlock Text="Total"
                               Foreground="#9CA3AF" FontWeight="SemiBold" FontSize="12"
                               Margin="0,0,0,6"/>
                    <Border Background="#0A2118" CornerRadius="6" Padding="14,10"
                            BorderBrush="#0D4F30" BorderThickness="1" Margin="0,0,0,12">
                        <TextBlock x:Name="TotalText" Text="&#x20B1;0.00"
                                   FontSize="26" FontWeight="Bold" Foreground="#10B981"
                                   HorizontalAlignment="Right"/>
                    </Border>

                    <!-- Cash Received -->
                    <TextBlock Text="Cash Received"
                               Foreground="#9CA3AF" FontWeight="SemiBold" FontSize="12"
                               Margin="0,0,0,6"/>
                    <Border Background="#090B17" CornerRadius="6"
                            BorderBrush="#128854" BorderThickness="1.5"
                            Padding="12,0" Margin="0,0,0,12">
                        <Grid Height="44">
                            <TextBlock Text="&#x20B1;" Foreground="#6B7280" FontSize="15"
                                       VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <TextBox x:Name="CashReceivedBox"
                                     Text="0"
                                     FontSize="20" FontWeight="Bold"
                                     Foreground="#F3F4F6"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Margin="18,0,0,0"
                                     VerticalContentAlignment="Center"
                                     HorizontalContentAlignment="Right"
                                     TextAlignment="Right"
                                     TextChanged="CashReceived_TextChanged"
                                     PreviewTextInput="NumericOnly_PreviewTextInput"
                                     GotFocus="CashReceivedBox_GotFocus"/>
                        </Grid>
                    </Border>

                    <!-- Change -->
                    <TextBlock Text="Change"
                               Foreground="#9CA3AF" FontWeight="SemiBold" FontSize="12"
                               Margin="0,0,0,6"/>
                    <Border Background="#0A2118" CornerRadius="6" Padding="14,10"
                            BorderBrush="#0D4F30" BorderThickness="1" Margin="0,0,0,12">
                        <TextBlock x:Name="ChangeText" Text="&#x20B1;0.00"
                                   FontSize="22" FontWeight="Bold" Foreground="#10B981"
                                   HorizontalAlignment="Right"/>
                    </Border>

                    <!-- Paid -->
                    <TextBlock Text="Paid"
                               Foreground="#9CA3AF" FontWeight="SemiBold" FontSize="12"
                               Margin="0,0,0,6"/>
                    <Border Background="#0F1220" CornerRadius="6" Padding="14,10"
                            BorderBrush="#1A1D2E" BorderThickness="1" Margin="0,0,0,14">
                        <TextBlock x:Name="PaidText" Text="&#x20B1;0.00"
                                   FontSize="15" FontWeight="SemiBold" Foreground="#9CA3AF"
                                   HorizontalAlignment="Right"/>
                    </Border>

                    <!-- Insufficient warning -->
                    <Border x:Name="InsufficientWarning"
                            Background="#1C0A0A" CornerRadius="6" Padding="12,8"
                            BorderBrush="#3D1010" BorderThickness="1"
                            Margin="0,0,0,12" Visibility="Collapsed">
                        <TextBlock Text="Cash received is less than the total amount."
                                   Foreground="#EF4444" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Remarks -->
                    <TextBlock Text="Remarks (Optional)"
                               Foreground="#9CA3AF" FontWeight="SemiBold" FontSize="12"
                               Margin="0,0,0,6"/>
                    <Border Background="#090B17" CornerRadius="6"
                            BorderBrush="#1A1D2E" BorderThickness="1"
                            Margin="0,0,0,24">
                        <TextBox x:Name="RemarksBox"
                                 Height="56"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalContentAlignment="Top"
                                 Padding="10,8"
                                 Foreground="#F3F4F6"
                                 Background="Transparent"
                                 BorderThickness="0"/>
                    </Border>

                    <!-- Action buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="PrintBtn" Content="Print"
                                Padding="20,10" FontSize="13" Cursor="Hand" Margin="0,0,8,0"
                                Click="Print_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="#0F1220" CornerRadius="6"
                                            BorderBrush="#1A1D2E" BorderThickness="1"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#1A1D2E"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="SaveBtn" Content="Save"
                                Padding="20,10" FontSize="13" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0"
                                Foreground="#000000"
                                Click="Save_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="#128854" CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#477C60"/>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Bg" Property="Opacity" Value="0.4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Content="Cancel"
                                Padding="20,10" FontSize="13" Cursor="Hand"
                                Click="Cancel_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="#0F1220" CornerRadius="6"
                                            BorderBrush="#1A1D2E" BorderThickness="1"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#1A1D2E"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>

                </StackPanel>

                <!-- ===================================================
                     RIGHT: Numpad
                     =================================================== -->
                <Border Grid.Column="2"
                        Background="#0D1117"
                        CornerRadius="10"
                        BorderBrush="#1A1D2E"
                        BorderThickness="1"
                        Padding="12">
                    <StackPanel>

                        <!-- Display -->
                        <Border Background="#090B17" CornerRadius="6" Padding="10,8"
                                Margin="0,0,0,10" BorderBrush="#1A1D2E" BorderThickness="1">
                            <TextBlock x:Name="NumpadDisplay"
                                       Text="0"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="#10B981"
                                       TextAlignment="Right"/>
                        </Border>

                        <!-- 7 8 9 / 4 5 6 / 1 2 3 / . 0 back -->
                        <UniformGrid Rows="4" Columns="3" Margin="0,0,0,4">
                            <Button Content="7" Style="{StaticResource NKey}" Tag="7" Click="Numpad_Click"/>
                            <Button Content="8" Style="{StaticResource NKey}" Tag="8" Click="Numpad_Click"/>
                            <Button Content="9" Style="{StaticResource NKey}" Tag="9" Click="Numpad_Click"/>
                            <Button Content="4" Style="{StaticResource NKey}" Tag="4" Click="Numpad_Click"/>
                            <Button Content="5" Style="{StaticResource NKey}" Tag="5" Click="Numpad_Click"/>
                            <Button Content="6" Style="{StaticResource NKey}" Tag="6" Click="Numpad_Click"/>
                            <Button Content="1" Style="{StaticResource NKey}" Tag="1" Click="Numpad_Click"/>
                            <Button Content="2" Style="{StaticResource NKey}" Tag="2" Click="Numpad_Click"/>
                            <Button Content="3" Style="{StaticResource NKey}" Tag="3" Click="Numpad_Click"/>
                            <Button Content="." Style="{StaticResource NKey}" Tag="." Click="Numpad_Click"/>
                            <Button Content="0" Style="{StaticResource NKey}" Tag="0" Click="Numpad_Click"/>
                            <Button Content="&#x232B;" Style="{StaticResource NKey}" Tag="back"
                                    FontFamily="Segoe UI Symbol" FontSize="16" Foreground="#9CA3AF"
                                    Click="Numpad_Click"/>
                        </UniformGrid>

                        <!-- Enter -->
                        <Button Content="Enter" Tag="enter" Click="Numpad_Click"
                                Height="44" FontSize="14" FontWeight="SemiBold"
                                Foreground="#000000" Cursor="Hand" Margin="3,0,3,4">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="#128854" CornerRadius="6">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#477C60"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bg" Property="Opacity" Value="0.8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Quick amounts -->
                        <TextBlock Text="Quick Amount" Foreground="#6B7280" FontSize="11"
                                   Margin="0,8,0,4" HorizontalAlignment="Center"/>
                        <UniformGrid Rows="2" Columns="2">
                            <Button Content="&#x20B1;100"  Style="{StaticResource QKey}" Tag="100"  Click="Quick_Click" Margin="0,0,3,3"/>
                            <Button Content="&#x20B1;200"  Style="{StaticResource QKey}" Tag="200"  Click="Quick_Click" Margin="3,0,0,3"/>
                            <Button Content="&#x20B1;500"  Style="{StaticResource QKey}" Tag="500"  Click="Quick_Click" Margin="0,3,3,0"/>
                            <Button Content="&#x20B1;1000" Style="{StaticResource QKey}" Tag="1000" Click="Quick_Click" Margin="3,3,0,0"/>
                        </UniformGrid>

                    </StackPanel>
                </Border>

            </Grid>
        </Grid>
    </Border>
</UserControl>
