<UserControl
    x:Class="SihyuPOSPayroll.Views.Cashier.POS.POSView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="clr-namespace:SihyuPOSPayroll.Helpers"
    xmlns:components="clr-namespace:SihyuPOSPayroll.Views.Components"
    Background="#000000">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <helpers:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
        <helpers:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter"/>

        <!-- ── Product card style ───────────────────────────────────────── -->
        <Style x:Key="ProductCardItem" TargetType="ListViewItem">
            <Setter Property="Padding"                  Value="0"/>
            <Setter Property="Margin"                   Value="0,0,12,12"/>
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle"         Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Page Header ── -->
        <Border BorderBrush="#072219" BorderThickness="0,0,0,1"
                Margin="0,0,0,20" Padding="0,0,0,14">
            <TextBlock Text="POS Panel"
                       FontSize="26" FontWeight="Bold" Foreground="#477C60"/>
        </Border>

        <!-- ── Main two-column layout ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="2.8*"/>
            </Grid.ColumnDefinitions>

            <!-- ============================================================
                 LEFT  –  Product Card Grid
                 ============================================================ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ── Quick Add / Barcode Scanner bar ──────────────────── -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#090B17"
                            CornerRadius="8"
                            BorderBrush="#0D1117"
                            BorderThickness="1"
                            Padding="12,0"
                            Height="40">
                        <Grid>
                            <TextBlock Text="&#xE943;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       Foreground="#477C60"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"/>
                            <TextBox x:Name="BarcodeBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#F3F4F6"
                                     VerticalContentAlignment="Center"
                                     Margin="22,0,0,0"
                                     KeyDown="BarcodeBox_KeyDown"
                                     TextChanged="BarcodeBox_TextChanged"/>
                            <TextBlock Text="Scan or type barcode…"
                                       Foreground="#6B7280"
                                       Margin="24,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding Text, ElementName=BarcodeBox,
                                                    Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Spinner -->
                        <Border x:Name="BarcodeSpinner"
                                Width="22" Height="22"
                                Margin="0,0,10,0"
                                Visibility="Collapsed">
                            <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                            <Border.RenderTransform>
                                <RotateTransform x:Name="BarcodeSpinnerRotate" Angle="0"/>
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Border.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="BarcodeSpinnerRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             From="0" To="360"
                                                             Duration="0:0:0.9"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <Ellipse Width="20" Height="20"
                                     Stroke="#477C60"
                                     StrokeThickness="2.5"
                                     StrokeDashArray="5,3"/>
                        </Border>

                        <TextBlock x:Name="BarcodeFeedback"
                                   Text=""
                                   Foreground="#477C60"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   FontWeight="Medium"
                                   MaxWidth="180"/>

                        <Button Content="Add +"
                                Style="{StaticResource PrimaryButton}"
                                Click="BarcodeAdd_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Search + Category toolbar -->
                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="160"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search box -->
                    <Border Background="#090B17"
                            CornerRadius="8"
                            BorderBrush="#1A1D2E"
                            BorderThickness="1"
                            Padding="12,0"
                            Height="40">
                        <Grid>
                            <TextBlock Text="&#xE721;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       Foreground="#6B7280"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"/>
                            <TextBox x:Name="SearchBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#F3F4F6"
                                     VerticalContentAlignment="Center"
                                     Margin="22,0,0,0"
                                     TextChanged="SearchBox_TextChanged"/>
                            <TextBlock Text="Search products…"
                                       Foreground="#6B7280"
                                       Margin="24,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding Text, ElementName=SearchBox,
                                                    Converter={StaticResource EmptyStringToVisibilityConverter}}"/>
                        </Grid>
                    </Border>

                    <!-- Category ComboBox -->
                    <ComboBox Grid.Column="2"
                              x:Name="CategoryCombo"
                              Height="40"
                              SelectionChanged="CategoryCombo_SelectionChanged"/>
                </Grid>

                <!-- Product card grid (WrapPanel inside ScrollViewer) -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ListView x:Name="ProductList"
                              Background="Transparent"
                              BorderThickness="0"
                              ItemContainerStyle="{StaticResource ProductCardItem}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <!-- WrapPanel: 3-column auto-wrapping card grid -->
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <!-- ── Product Card (entire card is clickable) ── -->
                                <Button Click="AddProduct_Click"
                                        Tag="{Binding}"
                                        Width="148"
                                        Cursor="Hand"
                                        Padding="0"
                                        BorderThickness="0"
                                        Background="Transparent">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="CardBorder"
                                                    Width="148"
                                                    Background="#090B17"
                                                    CornerRadius="12"
                                                    BorderBrush="#1A1D2E"
                                                    BorderThickness="1"
                                                    Padding="0,0,0,12">
                                                <StackPanel>
                                                    <!-- Product image / placeholder -->
                                                    <Border CornerRadius="12,12,0,0"
                                                            Height="100"
                                                            ClipToBounds="True"
                                                            Background="#0D0F1A">
                                                        <Grid>
                                                            <!-- Placeholder icon -->
                                                            <Border Width="52" Height="52"
                                                                    CornerRadius="26"
                                                                    Background="#072219"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="&#xE8B9;"
                                                                           FontFamily="Segoe MDL2 Assets"
                                                                           FontSize="22"
                                                                           Foreground="#128854"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                            <!-- Actual product image -->
                                                            <Image x:Name="ProductImage"
                                                                   Stretch="UniformToFill"
                                                                   Tag="{Binding ImageUrl}"
                                                                   Loaded="ProductImage_Loaded">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ImageUrl}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Name -->
                                                    <TextBlock Text="{Binding Name}"
                                                               Foreground="#F3F4F6"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"
                                                               MaxHeight="38"
                                                               Margin="10,10,10,6"
                                                               TextTrimming="CharacterEllipsis"/>

                                                    <!-- Price + "+" badge row -->
                                                    <Grid Margin="10,0,10,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Text="{Binding Price, StringFormat=₱{0:N2}}"
                                                                   Foreground="#10B981"
                                                                   FontSize="14"
                                                                   FontWeight="Bold"
                                                                   VerticalAlignment="Center"/>

                                                        <!-- "+" badge (visual only, click handled by card) -->
                                                        <Border Grid.Column="1"
                                                                x:Name="PlusBadge"
                                                                Width="32" Height="32"
                                                                CornerRadius="16"
                                                                Background="#10B981">
                                                            <TextBlock Text="+"
                                                                       FontSize="18"
                                                                       FontWeight="Bold"
                                                                       Foreground="#000000"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"/>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- Hover / press visual triggers -->
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="#10B981"/>
                                                    <Setter TargetName="CardBorder" Property="Background" Value="#0D1220"/>
                                                    <Setter TargetName="PlusBadge"  Property="Background" Value="#128854"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="CardBorder" Property="Background" Value="#0A1A18"/>
                                                    <Setter TargetName="CardBorder" Property="BorderBrush" Value="#128854"/>
                                                    <Setter TargetName="PlusBadge"  Property="Background" Value="#0D6B43"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </ScrollViewer>
            </Grid>

            <!-- ============================================================
                 RIGHT  –  Current Order Panel
                 ============================================================ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Order header -->
                <Border Grid.Row="0"
                        Background="#090B17"
                        CornerRadius="10,10,0,0"
                        Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Current Order"
                                   FontSize="17" FontWeight="Bold"
                                   Foreground="#F3F4F6"
                                   VerticalAlignment="Center"/>

                        <!-- Payment (hidden in POS) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <TextBlock Text="Payment:"
                                       Foreground="#6B7280" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Width="105"
                                      ItemsSource="{Binding PaymentStatuses}"
                                      SelectedItem="{Binding EditingPaymentStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <!-- Status (hidden in POS) -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="Collapsed">
                            <TextBlock Text="Status:"
                                       Foreground="#6B7280" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Width="120"
                                      ItemsSource="{Binding OrderStatuses}"
                                      SelectedItem="{Binding EditingOrderStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Order items DataGrid -->
                <Border Grid.Row="1" Background="#090B17">
                    <DataGrid x:Name="ItemsGrid"
                              ItemsSource="{Binding EditingItems}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="False"
                              HeadersVisibility="Column"
                              Background="Transparent"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#0F1220"
                              ColumnHeaderHeight="40"
                              RowHeight="52"
                              CellEditEnding="ItemsGrid_CellEditEnding">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#0D1117"/>
                                <Setter Property="Foreground" Value="#6B7280"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="12,8"/>
                                <Setter Property="BorderBrush" Value="#0F1220"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <!-- Product with qty controls -->
                            <DataGridTemplateColumn Header="Item" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="8,0">
                                            <TextBlock Text="{Binding ProductName}"
                                                       Foreground="#F3F4F6"
                                                       FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding UnitPrice, StringFormat=₱{0:N2} each}"
                                                       Foreground="#6B7280"
                                                       FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.MenuProducts, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  DisplayMemberPath="Name"
                                                  SelectedValuePath="Id"
                                                  SelectedValue="{Binding ProductId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  SelectionChanged="ProductCombo_SelectionChanged"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <!-- Qty with − / + inline -->
                            <DataGridTemplateColumn Header="Qty" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <Button Content="−"
                                                    Width="24" Height="24"
                                                    FontSize="14" FontWeight="Bold"
                                                    Foreground="#F3F4F6"
                                                    Cursor="Hand"
                                                    Click="DecrQty_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bg" CornerRadius="12"
                                                                Background="#1A1D2E"
                                                                Width="24" Height="24">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bg" Property="Background" Value="#272A3A"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <TextBlock Text="{Binding Quantity}"
                                                       Foreground="#F3F4F6"
                                                       FontSize="14" FontWeight="SemiBold"
                                                       Width="28"
                                                       TextAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <Button Content="+"
                                                    Width="24" Height="24"
                                                    FontSize="14" FontWeight="Bold"
                                                    Foreground="#000000"
                                                    Cursor="Hand"
                                                    Click="IncrQty_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bg" CornerRadius="12"
                                                                Background="#10B981"
                                                                Width="24" Height="24">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bg" Property="Background" Value="#128854"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Subtotal"
                                                IsReadOnly="True"
                                                Binding="{Binding Subtotal, StringFormat=₱{0:N2}}"
                                                Width="1.1*"/>

                            <DataGridTemplateColumn Header="" Width="36">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕"
                                                ToolTip="Remove"
                                                Click="RemoveLine_Click"
                                                Cursor="Hand"
                                                FontSize="12"
                                                Foreground="#6B7280"
                                                Width="28" Height="28">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bg" CornerRadius="6"
                                                            Background="Transparent">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bg" Property="Background" Value="#331A1A"/>
                                                            <Setter Property="Foreground" Value="#EF4444"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <!-- Total summary bar -->
                <Border Grid.Row="2"
                        Background="#0D1117"
                        Padding="16,12"
                        BorderBrush="#072219"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Total"
                                   Foreground="#9CA3AF"
                                   FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding EditingOrder.TotalAmount, StringFormat=₱{0:N2}}"
                                   Foreground="#10B981"
                                   FontSize="22" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Footer: Order Type + action buttons -->
                <Border Grid.Row="3"
                        Background="#090B17"
                        CornerRadius="0,0,10,10"
                        Padding="16,12"
                        BorderBrush="#0F1220"
                        BorderThickness="0,1,0,0">
                    <DockPanel LastChildFill="False">

                        <!-- Order Type (RestaurantMode only) -->
                        <StackPanel DockPanel.Dock="Left"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsOrderTypeRequired, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Margin="0,0,16,0">
                            <TextBlock Text="Order Type:"
                                       Foreground="#9CA3AF"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <RadioButton Content="Dine-In"
                                         Foreground="#F3F4F6"
                                         Margin="0,0,10,0"
                                         GroupName="OrderType"
                                         IsChecked="{Binding SelectedOrderType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=DineIn}"/>
                            <RadioButton Content="Take-Out"
                                         Foreground="#F3F4F6"
                                         Margin="0,0,16,0"
                                         GroupName="OrderType"
                                         IsChecked="{Binding SelectedOrderType, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=TakeOut}"/>
                            <TextBlock Text="Please select Dine-In or Take-Out"
                                       Foreground="#EF4444"
                                       VerticalAlignment="Center"
                                       FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsOrderTypeRequired}" Value="True"/>
                                                    <Condition Binding="{Binding CanConfirmOrder}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- Action buttons -->
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Content="+ Add Item"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,8,0"
                                    Click="AddLine_Click"/>
                            <Button Style="{StaticResource PrimaryButton}"
                                    Margin="0,0,8,0"
                                    Click="SaveEditor_Click"
                                    IsEnabled="{Binding CanConfirmOrder}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Settle Payment"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="#000000" VerticalAlignment="Center"/>
                                    <Border Background="#005533" CornerRadius="3"
                                            Padding="4,1" Margin="7,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="F3"
                                                   FontSize="10" FontWeight="Bold"
                                                   Foreground="#00FF88"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button Content="Cancel"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="CancelEditor_Click"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ── Dialog Overlay (spans full POS content area) ─────────────────── -->
        <Border Grid.Row="1"
                Background="#B2000000"
                x:Name="DialogOverlay"
                Visibility="Collapsed"
                Padding="24">
            <ContentPresenter x:Name="DialogHost"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
        </Border>

        <!-- Center banner — purchase success / item saved feedback -->
        <components:CenterBanner x:Name="POSCenterBanner"
                                 Grid.Row="0" Grid.RowSpan="2"
                                 Panel.ZIndex="200"/>

    </Grid>
</UserControl>
