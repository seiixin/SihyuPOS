<UserControl x:Class="SihyuPOSPayroll.Views.Cashier.POS.POSNewItemDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <Border Style="{StaticResource CardBorder}"
            Width="540"
            VerticalAlignment="Center"
            HorizontalAlignment="Center">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ── Header ─────────────────────────────────────────────── -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <!-- Icon + Title -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Border Width="36" Height="36"
                            CornerRadius="18"
                            Background="#2A1A0A"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="&#xE7BA;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="16"
                                   Foreground="#FCD34D"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Item Not in Inventory"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#F3F4F6"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Message -->
                <Border Background="#1C1400"
                        CornerRadius="8"
                        Padding="14,10"
                        BorderBrush="#3D2A00"
                        BorderThickness="1">
                    <TextBlock TextWrapping="Wrap"
                               FontSize="13"
                               Foreground="#FCD34D"
                               LineHeight="20">
                        <Run Text="This item doesn't exist yet on the inventory."/>
                        <LineBreak/>
                        <Run Text="Please set a price on the item before adding it to the cart."
                             Foreground="#9CA3AF"/>
                    </TextBlock>
                </Border>
            </StackPanel>

            <!-- ── Divider ────────────────────────────────────────────── -->
            <Border Grid.Row="1"
                    Height="1"
                    Background="#1A1D2E"
                    Margin="0,0,0,20"/>

            <!-- ── Form Fields ────────────────────────────────────────── -->
            <StackPanel Grid.Row="2" Orientation="Vertical">

                <!-- Barcode (pre-filled, read-only) -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Barcode"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontWeight="Medium" Margin="0,0,0,4"/>
                    <TextBox x:Name="BarcodeBox"
                             Height="40"
                             IsReadOnly="True"
                             Foreground="#6B7280"/>
                    <!-- Lookup status row — hidden when idle -->
                    <Grid x:Name="LookupStatusRow" Margin="0,6,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="LookupSpinner"
                                Grid.Column="0"
                                Width="14" Height="14"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                        From="0" To="360" Duration="0:0:1"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.RenderTransformOrigin>0.5,0.5</Border.RenderTransformOrigin>
                            <Border.RenderTransform>
                                <RotateTransform/>
                            </Border.RenderTransform>
                            <Ellipse Width="12" Height="12"
                                     Stroke="#60A5FA"
                                     StrokeThickness="2"
                                     StrokeDashArray="2 1"/>
                        </Border>
                        <TextBlock x:Name="LookupStatusText"
                                   Grid.Column="1"
                                   FontSize="11"
                                   Foreground="#9CA3AF"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>

                <!-- Product Name -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Product Name *"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontWeight="Medium" Margin="0,0,0,4"/>
                    <TextBox x:Name="ProductNameBox" Height="40"/>
                </StackPanel>

                <!-- Category -->
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Category"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontWeight="Medium" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CategoryBox"
                              Height="40"
                              IsEditable="True"/>
                </StackPanel>

                <!-- Quantity & Price -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Quantity *"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontWeight="Medium" Margin="0,0,0,4"/>
                        <TextBox x:Name="QuantityBox"
                                 Height="40"
                                 PreviewTextInput="NumberOnly_PreviewTextInput"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <!-- Price label highlighted since it's required for cart add -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Price *"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontWeight="Medium"/>
                            <Border Background="#10B981"
                                    CornerRadius="4"
                                    Padding="6,1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="Required for cart"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="#000000"/>
                            </Border>
                        </StackPanel>
                        <TextBox x:Name="PriceBox"
                                 Height="40"
                                 GotFocus="PriceBox_GotFocus"
                                 PreviewTextInput="PriceOnly_PreviewTextInput"
                                 BorderBrush="#10B981"
                                 BorderThickness="1"/>
                    </StackPanel>
                </Grid>

                <!-- Expiry Date (optional) -->
                <StackPanel Margin="0,0,0,4">
                    <TextBlock Text="Expiry Date (Optional)"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               FontWeight="Medium" Margin="0,0,0,4"/>
                    <DatePicker x:Name="ExpiryDatePicker" Height="40"/>
                </StackPanel>

            </StackPanel>

            <!-- ── Buttons ────────────────────────────────────────────── -->
            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,22,0,0">
                <Button Content="Save &amp; Add to Cart"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,0,8,0"
                        Click="Save_Click"/>
                <Button Content="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
