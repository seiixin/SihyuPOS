<Window x:Class="SihyuPOSPayroll.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="SariQuick — Sign In"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowState="Maximized"
        MinWidth="860" MinHeight="560"
        Background="#F9FCFA">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left: login form (45%) -->
            <ColumnDefinition Width="0.45*"/>
            <!-- Right: banner (55%) -->
            <ColumnDefinition Width="0.55*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════════
             LEFT PANEL — off-white login form
        ═══════════════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="#FAFCFB"
                BorderBrush="#C2DDD0"
                BorderThickness="0,0,1,0">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- header -->
                    <RowDefinition Height="*"/>     <!-- form -->
                    <RowDefinition Height="Auto"/>  <!-- footer -->
                </Grid.RowDefinitions>

                <!-- ── Brand header ── -->
                <Border Grid.Row="0" Padding="40,28,40,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <!-- Cart + lightning bolt logo square -->
                        <Border Width="36" Height="36" CornerRadius="10"
                                Margin="0,0,10,0">
                            <Border.Background>
                                <SolidColorBrush Color="#066839"/>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" Color="#066839"
                                                  ShadowDepth="0" Opacity="0.35"/>
                            </Border.Effect>
                            <!-- Cart icon path approximated with Segoe MDL2 -->
                            <TextBlock Text="&#xE7BF;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18" Foreground="#FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="SariQuick"
                                   FontSize="20" FontWeight="ExtraBold"
                                   Foreground="#066839"
                                   VerticalAlignment="Center"/>

                        <!-- Desktop POS status pill -->
                        <Border Background="#EAF5EF" BorderBrush="#C2DDD0"
                                BorderThickness="1" CornerRadius="20"
                                Padding="10,4" Margin="12,0,0,0"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#10B981"
                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Desktop POS"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="#066839" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ── Login form (centered) ── -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Border Padding="40,32,40,24"
                            MaxWidth="420"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                        <StackPanel>

                            <!-- Context heading -->
                            <TextBlock Text="POS &amp; STORE MANAGEMENT SYSTEM"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="#0F8A4D" Margin="0,0,0,6"/>

                            <TextBlock Text="Welcome back"
                                       FontSize="26" FontWeight="ExtraBold"
                                       Foreground="#0A2E1D" Margin="0,0,0,6"/>

                            <TextBlock Text="Sign in to launch your desktop POS register, track real-time inventory, and manage daily store sales."
                                       FontSize="12" Foreground="#4B6658"
                                       TextWrapping="Wrap" Margin="0,0,0,28"
                                       LineHeight="18"/>

                            <!-- Email label + field -->
                            <TextBlock Text="Username or Email"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="#0A2E1D" Margin="0,0,0,6"/>

                            <Border Background="#FFFFFF" CornerRadius="12"
                                    BorderBrush="#C2DDD0" BorderThickness="1"
                                    Margin="0,0,0,16" Height="44">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True">
                                                <Setter Property="BorderBrush" Value="#066839"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <!-- User icon -->
                                    <TextBlock Text="&#xE77B;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13" Foreground="#4B6658"
                                               VerticalAlignment="Center"
                                               Margin="14,0,0,0"/>
                                    <TextBox x:Name="EmailTextBox"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="#0A2E1D"
                                             FontSize="13"
                                             Padding="36,0,12,0"
                                             CaretBrush="#066839"
                                             SelectionBrush="#CBE3D5"
                                             VerticalContentAlignment="Center"
                                             TextChanged="EmailTextBox_TextChanged"
                                             GotFocus="Input_GotFocus"
                                             LostFocus="Input_LostFocus"/>
                                    <TextBlock x:Name="EmailPlaceholderText"
                                               Text="admin@sariquick.ph"
                                               Foreground="#9AB5A8"
                                               FontSize="13"
                                               Margin="36,0,0,0"
                                               IsHitTestVisible="False"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Password label + field -->
                            <TextBlock Text="Password"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="#0A2E1D" Margin="0,0,0,6"/>

                            <Border Background="#FFFFFF" CornerRadius="12"
                                    BorderBrush="#C2DDD0" BorderThickness="1"
                                    Margin="0,0,0,16" Height="44">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True">
                                                <Setter Property="BorderBrush" Value="#066839"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <!-- Lock icon -->
                                    <TextBlock Text="&#xE72E;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13" Foreground="#4B6658"
                                               VerticalAlignment="Center"
                                               Margin="14,0,0,0"/>
                                    <PasswordBox x:Name="PasswordBox"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="#0A2E1D"
                                                 FontSize="13"
                                                 Padding="36,0,42,0"
                                                 VerticalContentAlignment="Center"
                                                 PasswordChanged="PasswordBox_PasswordChanged"/>
                                    <TextBlock x:Name="PasswordPlaceholder"
                                               Text="Enter your password"
                                               Foreground="#9AB5A8"
                                               FontSize="13"
                                               Margin="36,0,0,0"
                                               IsHitTestVisible="False"
                                               VerticalAlignment="Center"/>
                                    <!-- Show/hide toggle -->
                                    <Button x:Name="TogglePasswordButton"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Width="36" HorizontalAlignment="Right"
                                            Cursor="Hand"
                                            Click="TogglePassword_Click">
                                        <TextBlock x:Name="EyeIcon"
                                                   Text="&#xE7B3;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13" Foreground="#4B6658"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Remember me -->
                            <CheckBox x:Name="RememberMeCheckBox"
                                      IsChecked="True"
                                      Margin="0,0,0,20"
                                      Cursor="Hand">
                                <TextBlock Text="Remember me on this workstation"
                                           FontSize="11" Foreground="#4B6658"/>
                            </CheckBox>

                            <!-- Error message -->
                            <Border x:Name="ErrorBanner"
                                    Background="#FEF2F2"
                                    BorderBrush="#FECACA"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12,8"
                                    Margin="0,0,0,12"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE783;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="13" Foreground="#DC2626"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBlock x:Name="ErrorText"
                                               Text="{Binding ErrorMessage}"
                                               FontSize="12" Foreground="#DC2626"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Sign In button -->
                            <Button x:Name="LoginButton"
                                    Height="46"
                                    Click="LoginButton_Click"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd"
                                                CornerRadius="12"
                                                Background="#066839">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="12" Color="#066839"
                                                                  ShadowDepth="0" Opacity="0.30"/>
                                            </Border.Effect>
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center">
                                                <TextBlock x:Name="BtnText"
                                                           Text="Sign In to SariQuick"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#FFFFFF"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="&#xE76C;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="11" Foreground="#FFFFFF"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#04522C"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- ── Footer ── -->
                <Border Grid.Row="2"
                        Padding="40,12,40,16"
                        BorderBrush="#EAF5EF"
                        BorderThickness="0,1,0,0"
                        MaxWidth="420"
                        HorizontalAlignment="Center">
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="#10B981"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="v1.0 · Local &amp; Cloud Sync Ready"
                                       FontSize="10" Foreground="#4B6658"/>
                        </StackPanel>
                        <TextBlock Text="SariQuick POS"
                                   FontSize="10" Foreground="#4B6658"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════
             RIGHT PANEL — banner image only
        ═══════════════════════════════════════════════════════ -->
        <Border Grid.Column="1" ClipToBounds="True" Background="#F0F7F3">
            <Image x:Name="BannerImage"
                   Stretch="UniformToFill"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>

    </Grid>
</Window>
